PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ledger
JWT_ACCESS_SECRET=ledger_access_secret_key_development_32chars_long_123
JWT_REFRESH_SECRET=ledger_refresh_secret_key_development_32chars_long_456
GEMINI_API_KEY=
# AI providers: set at least one. With several, they are tried in order and a
# failure falls through to the next. Order: AI_PROVIDER_ORDER (default gemini,claude,openai,groq).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER_ORDER=
FRONTEND_URL=http://localhost:5173
# Optional operational defaults used by the admin console
ADMIN_RATE_LIMIT_PER_MINUTE=120
DEFAULT_AI_DAILY_LIMIT=100
MAX_UPLOAD_SIZE_BYTES=8388608
# Redis (optional locally, recommended in production): shared rate-limit counters and
# a short admin cache. Use rediss:// for TLS. Without it, limits are per-process memory.
REDIS_URL=
RATE_LIMIT_PREFIX=ledger:rl:
# Proxy hops to trust for req.ip (default 1 in production, off in development).
TRUST_PROXY=
